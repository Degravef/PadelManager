@page "/membres/create"
@rendermode InteractiveServer
@inject NavigationManager NavigationManager
@inject IMembreService MembreService

@using System.ComponentModel.DataAnnotations

<PageTitle>Register Member</PageTitle>

<MudText Typo="Typo.h4" GutterBottom="true">Register Member</MudText>

@if (createdMatricule is not null)
{
    <MudAlert Severity="Severity.Success" Class="mb-4">
        Registration complete — your matricule is <strong>@createdMatricule</strong>. There is no
        login, so this is the only way to identify yourself again: write it down, then continue below.
    </MudAlert>
    <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="ContinueAsNewMembre">Continue as @createdMatricule</MudButton>
    return;
}

<MudAlert Severity="Severity.Info" Class="mb-4">
    There is no login — pick your member type below and a matricule will be generated for you.
</MudAlert>

@if (!string.IsNullOrEmpty(errorMessage))
{
    <MudAlert Severity="Severity.Error" Class="mb-4" OnClose="@(() => errorMessage = null)">@errorMessage</MudAlert>
}

<MudPaper Class="pa-6" Elevation="1">
    <EditForm Model="model" OnValidSubmit="HandleValidSubmit">
        <DataAnnotationsValidator />

        <MudGrid>
            <MudItem xs="12" md="6">
                <MudTextField Label="Name" @bind-Value="model.Name" For="@(() => model.Name)" Required="true" Variant="Variant.Outlined" Margin="Margin.Dense" />
            </MudItem>
            <MudItem xs="12" md="6">
                <MudTextField Label="First name" @bind-Value="model.FirstName" For="@(() => model.FirstName)" Required="true" Variant="Variant.Outlined" Margin="Margin.Dense" />
            </MudItem>
            <MudItem xs="12" md="6">
                <MudTextField Label="Email (optional)" @bind-Value="model.Email" For="@(() => model.Email)" Variant="Variant.Outlined" Margin="Margin.Dense" />
            </MudItem>
            <MudItem xs="12" md="6">
                <MudTextField Label="Phone (optional)" @bind-Value="model.Telephone" For="@(() => model.Telephone)" Variant="Variant.Outlined" Margin="Margin.Dense" />
            </MudItem>
            <MudItem xs="12" md="6">
                <MudSelect T="string" Label="Member type" @bind-Value="model.Type" For="@(() => model.Type)" Required="true" Variant="Variant.Outlined" Margin="Margin.Dense">
                    <MudSelectItem Value="@TypeGlobal">Global — any site, 3-week booking window</MudSelectItem>
                    <MudSelectItem Value="@TypeSite">Site — own site only, 2-week booking window</MudSelectItem>
                    <MudSelectItem Value="@TypeLibre">Libre — any site, 5-day booking window</MudSelectItem>
                </MudSelect>
            </MudItem>
            @if (model.Type == TypeSite)
            {
                <MudItem xs="12" md="6">
                    <MudNumericField T="int?" Label="Site ID" @bind-Value="model.SiteId" Required="true" Variant="Variant.Outlined" Margin="Margin.Dense"
                                     HelperText="Ask your site administrator for your Site ID." />
                </MudItem>
            }
            <MudItem xs="12" Class="d-flex align-center justify-end">
                <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary" Class="ml-auto" Disabled="@submitting">Register</MudButton>
                <MudButton Variant="Variant.Outlined" Color="Color.Secondary" Class="ml-2" Href="/">Cancel</MudButton>
            </MudItem>
        </MudGrid>
    </EditForm>
</MudPaper>

@code {
    // Matches Core.Constants.TypeMembreSeed's codes — duplicated here since Web can't reference Core.
    private const string TypeGlobal = "GLOBAL";
    private const string TypeSite = "SITE";
    private const string TypeLibre = "LIBRE";

    private MembreModel model = new() { Type = TypeGlobal };
    private string? errorMessage;
    private string? createdMatricule;
    private bool submitting;

    private async Task HandleValidSubmit()
    {
        submitting = true;
        try
        {
            var membre = await MembreService.CreateMembreAsync(new CreateMembreDto(model.Name, model.FirstName, model.Type, model.SiteId, model.Email, model.Telephone));
            createdMatricule = membre.Matricule;
        }
        catch (ApiException ex)
        {
            errorMessage = ex.Message;
        }
        catch (HttpRequestException)
        {
            errorMessage = "Unable to reach the server.";
        }
        finally
        {
            submitting = false;
        }
    }

    // Switches identity to the newly-created member, the same way IdentityBar does — the matricule
    // was unknown before registration, so there was nothing to "act as" until now.
    private void ContinueAsNewMembre()
    {
        var uri = NavigationManager.GetUriWithQueryParameters("/membres/me", new Dictionary<string, object?>
        {
            ["role"] = "Member",
            ["id"] = createdMatricule
        });
        NavigationManager.NavigateTo(uri, forceLoad: true);
    }

    public class MembreModel
    {
        [Required]
        [StringLength(100)]
        public string Name { get; set; } = string.Empty;

        [Required]
        [StringLength(100)]
        public string FirstName { get; set; } = string.Empty;

        [Required]
        public string Type { get; set; } = TypeGlobal;

        public int? SiteId { get; set; }

        [EmailAddress]
        [StringLength(255)]
        public string? Email { get; set; }

        [StringLength(30)]
        public string? Telephone { get; set; }
    }
}
