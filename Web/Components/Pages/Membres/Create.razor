@page "/membres/create"
@rendermode InteractiveServer
@inject NavigationManager NavigationManager
@inject IMembreService MembreService
@inject UserContext UserContext

@using System.ComponentModel.DataAnnotations
@using Web.Services.Context

<PageTitle>Register Member</PageTitle>

<MudText Typo="Typo.h4" GutterBottom="true">Register Member</MudText>

<MudAlert Severity="Severity.Info" Class="mb-4">
    Registering as matricule <strong>@UserContext.Id</strong> — switch to "Membre" and set the matricule above if this isn't the identity you want to register.
</MudAlert>

@if (!string.IsNullOrEmpty(errorMessage))
{
    <MudAlert Severity="Severity.Error" Class="mb-4" OnClose="@(() => errorMessage = null)">@errorMessage</MudAlert>
}

<MudPaper Class="pa-6" Elevation="1">
    <EditForm Model="model" OnValidSubmit="HandleValidSubmit">
        <DataAnnotationsValidator />

        <MudGrid>
            <MudItem xs="12" md="6">
                <MudTextField Label="Name" @bind-Value="model.Name" For="@(() => model.Name)" Required="true" Variant="Variant.Outlined" Margin="Margin.Dense" />
            </MudItem>
            <MudItem xs="12" md="6">
                <MudTextField Label="First name" @bind-Value="model.FirstName" For="@(() => model.FirstName)" Required="true" Variant="Variant.Outlined" Margin="Margin.Dense" />
            </MudItem>
            @if (IsSiteMember)
            {
                <MudItem xs="12" md="6">
                    <MudNumericField T="int?" Label="Site ID" @bind-Value="model.SiteId" Required="true" Variant="Variant.Outlined" Margin="Margin.Dense"
                                     HelperText="Ask your site administrator for your Site ID." />
                </MudItem>
            }
            <MudItem xs="12" Class="d-flex align-center justify-end">
                <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary" Class="ml-auto" Disabled="@submitting">Register</MudButton>
                <MudButton Variant="Variant.Outlined" Color="Color.Secondary" Class="ml-2" Href="/">Cancel</MudButton>
            </MudItem>
        </MudGrid>
    </EditForm>
</MudPaper>

@code {
    private MembreModel model = new();
    private string? errorMessage;
    private bool submitting;

    // ASSUMPTION: a Site-type matricule (prefix S) must supply its Site ID directly rather than picking
    // it from a dropdown — GET /api/sites is Admin-only (see SitesController), and opening that endpoint
    // up to the Member role is a separate authorization decision outside this feature's scope.
    private bool IsSiteMember => UserContext.Id.Length > 0 && char.ToUpperInvariant(UserContext.Id[0]) == 'S';

    private async Task HandleValidSubmit()
    {
        submitting = true;
        try
        {
            await MembreService.CreateMembreAsync(new CreateMembreDto(model.Name, model.FirstName, model.SiteId));
            NavigationManager.NavigateTo("/membres/me");
        }
        catch (ApiException ex)
        {
            errorMessage = ex.Message;
        }
        catch (HttpRequestException)
        {
            errorMessage = "Unable to reach the server.";
        }
        finally
        {
            submitting = false;
        }
    }

    public class MembreModel
    {
        [Required]
        [StringLength(100)]
        public string Name { get; set; } = string.Empty;

        [Required]
        [StringLength(100)]
        public string FirstName { get; set; } = string.Empty;

        public int? SiteId { get; set; }
    }
}
