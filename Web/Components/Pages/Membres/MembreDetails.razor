<MudPaper Class="pa-6" Elevation="1">
    <MudGrid>
        <MudItem xs="12" md="6"><MudText><strong>Matricule:</strong> @Membre.Matricule</MudText></MudItem>
        <MudItem xs="12" md="6"><MudText><strong>Type:</strong> @Membre.TypeMembre</MudText></MudItem>
        <MudItem xs="12" md="6"><MudText><strong>Nom :</strong> @Membre.Name</MudText></MudItem>
        <MudItem xs="12" md="6"><MudText><strong>Prénom :</strong> @Membre.FirstName</MudText></MudItem>
        @if (Membre.SiteId != null)
        {
            <MudItem xs="12" md="6"><MudText><strong>ID du site :</strong> @Membre.SiteId</MudText></MudItem>
        }
        <MudItem xs="12" md="6"><MudText><strong>Email :</strong> @(Membre.Email ?? "-")</MudText></MudItem>
        <MudItem xs="12" md="6"><MudText><strong>Téléphone :</strong> @(Membre.Telephone ?? "-")</MudText></MudItem>
        <MudItem xs="12" md="6"><MudText><strong>Rôle :</strong> @Membre.Role</MudText></MudItem>
        <MudItem xs="12" md="6"><MudText><strong>Membre depuis :</strong> @Membre.DateInscription.ToString("d")</MudText></MudItem>
        <MudItem xs="12" md="6">
            <MudText Color="@(Membre.Actif ? Color.Success : Color.Default)">
                <strong>Statut :</strong> @(Membre.Actif ? "Actif" : "Inactif")
            </MudText>
        </MudItem>
        <MudItem xs="12" md="6">
            <MudText Color="@(Membre.SoldeDu > 0 ? Color.Error : Color.Success)">
                <strong>Solde dû :</strong> @Membre.SoldeDu.ToString("C")
            </MudText>
        </MudItem>
        @if (Membre.DateFinPenalite != null)
        {
            <MudItem xs="12" md="6">
                <MudText Color="Color.Warning"><strong>Pénalité jusqu'au :</strong> @Membre.DateFinPenalite.Value.ToShortDateString()</MudText>
            </MudItem>
        }
    </MudGrid>
</MudPaper>

@code {
    [Parameter, EditorRequired]
    public required MembreDto Membre { get; set; }
}
