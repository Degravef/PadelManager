@page "/reservations/create"
@rendermode InteractiveServer
@inject NavigationManager NavigationManager
@inject IReservationService ReservationService

@using System.ComponentModel.DataAnnotations
@using Web.Core.Dtos

<PageTitle>New Reservation</PageTitle>

<MudText Typo="Typo.h4" GutterBottom="true">New Reservation</MudText>

@if (!string.IsNullOrEmpty(errorMessage))
{
    <MudAlert Severity="Severity.Error" Class="mb-4" OnClose="@(() => errorMessage = null)">@errorMessage</MudAlert>
}

<MudPaper Class="pa-6" Elevation="1">
    <EditForm Model="model" OnValidSubmit="HandleValidSubmit">
        <DataAnnotationsValidator />

        <MudGrid>
            <MudItem xs="12" md="3">
                <MudSelect T="int?" Label="Site" Value="selectedSiteId" ValueChanged="OnSiteChangedAsync"
                           Variant="Variant.Outlined" Margin="Margin.Dense" Required="true">
                    @foreach (var site in sites)
                    {
                        <MudSelectItem T="int?" Value="@site.Id">@site.Name</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>
            <MudItem xs="12" md="3">
                <MudSelect T="int" Label="Terrain" @bind-Value="model.TerrainId" For="@(() => model.TerrainId)" Required="true"
                           Disabled="@(selectedSiteId is null)"
                           Variant="Variant.Outlined" Margin="Margin.Dense">
                    @foreach (var terrain in terrains)
                    {
                        <MudSelectItem T="int" Value="@terrain.Id">@terrain.Name</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>
            <MudItem xs="12" md="3">
                <MudDatePicker Label="Date" @bind-Date="model.Date" Required="true" Variant="Variant.Outlined" Margin="Margin.Dense" />
            </MudItem>
            <MudItem xs="12" md="3">
                <MudTimePicker Label="Start time" @bind-Time="model.StartTime" Required="true" Variant="Variant.Outlined" Margin="Margin.Dense"
                               HelperText="Slots are spaced every 1h45 starting at the site's opening hour." />
            </MudItem>
            <MudItem xs="12">
                <MudSwitch T="bool" @bind-Value="model.EstPublic" Color="Color.Primary" Label="Créer un match public" />
                <MudText Typo="Typo.caption" Class="mud-text-secondary">
                    Privé (par défaut) : vous inscrivez vous-même les 3 autres joueurs. Public : chaque joueur trouve le match et s'inscrit lui-même.
                </MudText>
            </MudItem>
            <MudItem xs="12" Class="d-flex align-center justify-end">
                <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary" Class="ml-auto" Disabled="@submitting">Reserve</MudButton>
                <MudButton Variant="Variant.Outlined" Color="Color.Secondary" Class="ml-2" Href="/reservations">Cancel</MudButton>
            </MudItem>
        </MudGrid>
    </EditForm>
</MudPaper>

@code {
    private ReservationModel model = new();
    private string? errorMessage;
    private bool submitting;
    private IEnumerable<SiteDto> sites = [];
    private IEnumerable<TerrainDto> terrains = [];
    private int? selectedSiteId;

    protected override async Task OnInitializedAsync()
    {
        sites = await ReservationService.GetSitesAsync();
    }

    private async Task OnSiteChangedAsync(int? siteId)
    {
        selectedSiteId = siteId;
        model.TerrainId = 0;
        terrains = siteId is null ? [] : await ReservationService.GetTerrainsBySiteAsync(siteId.Value);
    }

    private async Task HandleValidSubmit()
    {
        submitting = true;
        try
        {
            var dto = new CreerReservationDto(
                model.TerrainId,
                DateOnly.FromDateTime(model.Date!.Value),
                TimeOnly.FromTimeSpan(model.StartTime!.Value),
                model.EstPublic);

            var match = await ReservationService.CreerReservationAsync(dto);
            NavigationManager.NavigateTo($"/reservations/{match.Id}");
        }
        catch (ApiException ex)
        {
            errorMessage = ex.Message;
        }
        catch (HttpRequestException)
        {
            errorMessage = "Unable to reach the server.";
        }
        finally
        {
            submitting = false;
        }
    }

    public class ReservationModel
    {
        [Range(1, int.MaxValue, ErrorMessage = "The Terrain ID must be a positive number.")]
        public int TerrainId { get; set; }

        [Required]
        public DateTime? Date { get; set; } = DateTime.Today.AddDays(1);

        [Required]
        public TimeSpan? StartTime { get; set; } = new TimeSpan(10, 0, 0);

        public bool EstPublic { get; set; }
    }
}
