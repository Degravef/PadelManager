@page "/reservations/{Id:int}"
@rendermode InteractiveServer
@inject IReservationService ReservationService

<PageTitle>Réservation #@Id</PageTitle>

<MudText Typo="Typo.h4" GutterBottom="true">Réservation #@Id</MudText>

@if (loading)
{
    <MudProgressCircular Color="Color.Primary" Indeterminate="true" />
}
else if (!string.IsNullOrEmpty(errorMessage))
{
    <MudAlert Severity="Severity.Error">@errorMessage</MudAlert>
}
else if (match != null)
{
    <MudPaper Class="pa-6" Elevation="1">
        <MudGrid>
            <MudItem xs="12" md="6"><MudText><strong>ID Terrain :</strong> @match.TerrainId</MudText></MudItem>
            <MudItem xs="12" md="6"><MudText><strong>Type:</strong> @match.TypeMatch</MudText></MudItem>
            <MudItem xs="12" md="6"><MudText><strong>Date :</strong> @match.Date.ToString("d")</MudText></MudItem>
            <MudItem xs="12" md="6"><MudText><strong>Heure :</strong> @match.StartTime.ToString("t") - @match.EndTime.ToString("t")</MudText></MudItem>
            <MudItem xs="12" md="6"><MudText><strong>Statut :</strong> @match.Statut</MudText></MudItem>
            <MudItem xs="12" md="6"><MudText><strong>Réservé le :</strong> @match.DateCreation.ToString("g")</MudText></MudItem>
            <MudItem xs="12" md="6"><MudText><strong>Date limite de paiement :</strong> @match.DateLimite.ToString("d")</MudText></MudItem>
            @if (match.DateBasculePublic != null)
            {
                <MudItem xs="12" md="6"><MudText Color="Color.Warning"><strong>Basculé en public le :</strong> @match.DateBasculePublic.Value.ToString("g")</MudText></MudItem>
            }
            <MudItem xs="12" md="6"><MudText><strong>Montant total :</strong> @match.MontantTotal.ToString("C")</MudText></MudItem>
            <MudItem xs="12" md="6">
                <MudText Color="@(match.MontantPaye >= match.MontantTotal ? Color.Success : Color.Warning)">
                    <strong>Montant payé :</strong> @match.MontantPaye.ToString("C") / @match.MontantTotal.ToString("C")
                </MudText>
            </MudItem>
        </MudGrid>
    </MudPaper>

    <MatchParticipants MatchId="Id" TypeMatch="@match.TypeMatch" OrganisateurId="match.OrganisateurId" Statut="@match.Statut" />
}

@code {
    [Parameter]
    public int Id { get; set; }

    private MatchDto? match;
    private bool loading = true;
    private string? errorMessage;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            match = await ReservationService.GetReservationByIdAsync(Id);
        }
        catch (ApiException ex)
        {
            errorMessage = ex.Message;
        }
        catch (HttpRequestException)
        {
            errorMessage = "Impossible de joindre le serveur.";
        }
        finally
        {
            loading = false;
        }
    }
}
