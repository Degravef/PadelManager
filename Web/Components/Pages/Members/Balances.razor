@page "/members/balances"
@rendermode InteractiveServer
@inject IPaymentService PaymentService

<PageTitle>Mes soldes</PageTitle>

<MudText Typo="Typo.h4" GutterBottom="true">Mes soldes</MudText>

@if (!string.IsNullOrEmpty(errorMessage))
{
    <MudAlert Severity="Severity.Error" Class="mb-4" OnClose="@(() => errorMessage = null)">@errorMessage</MudAlert>
}

<MudSelect T="string" Label="Moyen de paiement" @bind-Value="paymentMethod" Variant="Variant.Outlined" Margin="Margin.Dense" Class="mb-4" Style="max-width:250px">
    <MudSelectItem Value="@("Carte")">Carte</MudSelectItem>
    <MudSelectItem Value="@("Especes")">Espèces</MudSelectItem>
    <MudSelectItem Value="@("Virement")">Virement bancaire</MudSelectItem>
</MudSelect>

<MudTable Items="@balances" Loading="@(balances == null)" Dense="true" Hover="true" Bordered="false" Striped="true" Elevation="1">
    <HeaderContent>
        <MudTh>Match</MudTh>
        <MudTh>Montant</MudTh>
        <MudTh>Statut</MudTh>
        <MudTh>Depuis</MudTh>
        <MudTh Style="text-align:right">Actions</MudTh>
    </HeaderContent>
    <RowTemplate>
        <MudTd DataLabel="Match">
            <MudLink Href="@($"/reservations/{context.MatchId}")">#@context.MatchId</MudLink>
        </MudTd>
        <MudTd DataLabel="Montant"><MudText Color="Color.Error">@context.Amount.ToString("C")</MudText></MudTd>
        <MudTd DataLabel="Statut">@context.Status</MudTd>
        <MudTd DataLabel="Depuis">@context.CreatedAt.ToString("d")</MudTd>
        <MudTd DataLabel="Actions" Style="text-align:right">
            <MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Primary" Disabled="@paying"
                       OnClick="@(() => PayAsync(context.Id))">Payer</MudButton>
        </MudTd>
    </RowTemplate>
    <NoRecordsContent>
        <MudText>Vous n'avez aucun solde en attente.</MudText>
    </NoRecordsContent>
    <LoadingContent>
        <MudText>Chargement des soldes...</MudText>
    </LoadingContent>
</MudTable>

@code {
    private IEnumerable<BalanceDueDto>? balances;
    private string? errorMessage;
    private bool paying;
    private string paymentMethod = "Carte";

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        try
        {
            balances = await PaymentService.GetMyUnpaidBalancesAsync();
        }
        catch (ApiException ex)
        {
            errorMessage = ex.Message;
        }
        catch (HttpRequestException)
        {
            errorMessage = "Impossible de joindre le serveur.";
        }
    }

    private async Task PayAsync(int balanceDueId)
    {
        paying = true;
        try
        {
            await PaymentService.PayBalanceDueAsync(balanceDueId, new PayDto(paymentMethod));
            await LoadAsync();
        }
        catch (ApiException ex)
        {
            errorMessage = ex.Message;
        }
        catch (HttpRequestException)
        {
            errorMessage = "Impossible de joindre le serveur.";
        }
        finally
        {
            paying = false;
        }
    }
}
