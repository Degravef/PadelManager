@page "/members"
@rendermode InteractiveServer
@inject IMemberService MemberService
@inject ISiteService SiteService

<PageTitle>Membres</PageTitle>

<MudText Typo="Typo.h4" GutterBottom="true">Membres</MudText>

@if (!string.IsNullOrEmpty(errorMessage))
{
    <MudAlert Severity="Severity.Error" Class="mb-4" OnClose="@(() => errorMessage = null)">@errorMessage</MudAlert>
}

<MudTable Items="@members" Loading="@(members == null)" Dense="true" Hover="true" Bordered="false" Striped="true" Elevation="1">
    <HeaderContent>
        <MudTh>Matricule</MudTh>
        <MudTh>Nom</MudTh>
        <MudTh>Prénom</MudTh>
        <MudTh>Type</MudTh>
        <MudTh>Site</MudTh>
        <MudTh>Solde dû</MudTh>
        <MudTh Style="text-align:right">Actions</MudTh>
    </HeaderContent>
    <RowTemplate>
        <MudTd DataLabel="Matricule">@context.Matricule</MudTd>
        <MudTd DataLabel="Nom">@context.Name</MudTd>
        <MudTd DataLabel="Prénom">@context.FirstName</MudTd>
        <MudTd DataLabel="Type">@context.MemberType</MudTd>
        <MudTd DataLabel="Site">@(context.SiteId is null ? "-" : SiteName(context.SiteId.Value))</MudTd>
        <MudTd DataLabel="Solde dû">@context.BalanceDue.ToString("C")</MudTd>
        <MudTd DataLabel="Actions" Style="text-align:right">
            <MudIconButton Icon="@Icons.Material.Filled.Visibility" Color="Color.Primary" Size="Size.Small" Href="@($"/members/{context.Id}")" Title="Voir" />
        </MudTd>
    </RowTemplate>
    <NoRecordsContent>
        <MudText>Aucun membre trouvé.</MudText>
    </NoRecordsContent>
    <LoadingContent>
        <MudText>Chargement des membres...</MudText>
    </LoadingContent>
</MudTable>

@code {
    private IEnumerable<MemberDto>? members;
    private IEnumerable<SiteDto> sites = [];
    private string? errorMessage;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            sites = await SiteService.GetAllSitesAsync();
            members = await MemberService.GetAllMembersAsync();
        }
        catch (ApiException ex)
        {
            errorMessage = ex.Message;
        }
        catch (HttpRequestException)
        {
            errorMessage = "Impossible de joindre le serveur.";
        }
    }

    private string SiteName(int siteId) => sites.FirstOrDefault(s => s.Id == siteId)?.Name ?? $"#{siteId}";
}
