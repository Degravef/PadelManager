@page "/sites"
@rendermode InteractiveServer
@inject ISiteService SiteService
@inject NavigationManager NavigationManager
@inject IJSRuntime JS

<PageTitle>Sites</PageTitle>

<h3>Sites</h3>

<div class="mb-3">
    <a href="/sites/create" class="btn btn-primary">Add Site</a>
</div>

@if (!string.IsNullOrEmpty(errorMessage))
{
    <div class="alert alert-danger">@errorMessage</div>
}

@if (sites == null)
{
    <p><em>Loading...</em></p>
}
else
{
    <table class="table">
        <thead>
            <tr>
                <th>Name</th>
                <th>Address</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var site in sites)
            {
                <tr>
                    <td>@site.Name</td>
                    <td>@site.Address</td>
                    <td>
                        <a href="/sites/edit/@site.Id" class="btn btn-sm btn-warning">Edit</a>
                        <button class="btn btn-sm btn-danger" @onclick="() => DeleteSite(site.Id)">Delete</button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    private IEnumerable<SiteDto>? sites;
    private string? errorMessage;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            sites = await SiteService.GetAllSitesAsync();
        }
        catch (Exception ex)
        {
            errorMessage = $"Error loading sites: {ex.Message}";
        }
    }

    private async Task DeleteSite(int id)
    {
        try
        {
            if (await JS.InvokeAsync<bool>("confirm", "Are you sure you want to delete this site?"))
            {
                await SiteService.DeleteSiteAsync(id);
                sites = await SiteService.GetAllSitesAsync();
                errorMessage = null;
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Error deleting site: {ex.Message}";
        }
    }
}
