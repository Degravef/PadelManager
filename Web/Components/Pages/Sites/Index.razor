@page "/sites"
@rendermode InteractiveServer
@inject ISiteService SiteService
@inject NavigationManager NavigationManager
@inject IJSRuntime JS

<PageTitle>Sites</PageTitle>

<MudText Typo="Typo.h4" GutterBottom="true">Sites</MudText>

<MudToolBar DisableGutters="true" Class="mb-4">
    <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" Href="/sites/create">Ajouter un site</MudButton>
</MudToolBar>

@if (!string.IsNullOrEmpty(errorMessage))
{
    <MudAlert Severity="Severity.Error" Class="mb-4" OnClose="@(() => errorMessage = null)">@errorMessage</MudAlert>
}

<MudTable Items="@sites" Loading="@(sites == null)" Dense="true" Hover="true" Bordered="false" Striped="true" Elevation="1">
    <HeaderContent>
        <MudTh>Nom</MudTh>
        <MudTh>Adresse</MudTh>
        <MudTh>Ville</MudTh>
        <MudTh>Téléphone</MudTh>
        <MudTh>Email</MudTh>
        <MudTh>Statut</MudTh>
        <MudTh Style="text-align:right">Actions</MudTh>
    </HeaderContent>
    <RowTemplate>
        <MudTd DataLabel="Nom">@context.Name</MudTd>
        <MudTd DataLabel="Adresse">@context.Address</MudTd>
        <MudTd DataLabel="Ville">@(context.PostalCode is null && context.City is null ? "-" : $"{context.PostalCode} {context.City}".Trim())</MudTd>
        <MudTd DataLabel="Téléphone">@(context.Phone ?? "-")</MudTd>
        <MudTd DataLabel="Email">@(context.Email ?? "-")</MudTd>
        <MudTd DataLabel="Statut">
            <MudChip T="string" Size="Size.Small" Color="@(context.Actif ? Color.Success : Color.Default)">@(context.Actif ? "Actif" : "Inactif")</MudChip>
        </MudTd>
        <MudTd DataLabel="Actions" Style="text-align:right">
            <MudIconButton Icon="@Icons.Material.Filled.Schedule" Color="Color.Primary" Size="Size.Small" Href="@($"/sites/{context.Id}/horaires")" Title="Horaires d'ouverture" />
            <MudIconButton Icon="@Icons.Material.Filled.Edit" Color="Color.Warning" Size="Size.Small" Href="@($"/sites/edit/{context.Id}")" Title="Modifier" />
            <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" Size="Size.Small" OnClick="@(() => DeleteSite(context.Id))" Title="Supprimer" />
        </MudTd>
    </RowTemplate>
    <NoRecordsContent>
        <MudText>Aucun site trouvé.</MudText>
    </NoRecordsContent>
    <LoadingContent>
        <MudText>Chargement des sites...</MudText>
    </LoadingContent>
</MudTable>

@code {
    private IEnumerable<SiteDto>? sites;
    private string? errorMessage;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            sites = await SiteService.GetAllSitesAsync();
        }
        catch (ApiException ex)
        {
            errorMessage = ex.Message;
        }
        catch (HttpRequestException)
        {
            errorMessage = "Impossible de charger les sites.";
        }
    }

    private async Task DeleteSite(int id)
    {
        try
        {
            if (await JS.InvokeAsync<bool>("confirm", "Êtes-vous sûr de vouloir supprimer ce site ?"))
            {
                await SiteService.DeleteSiteAsync(id);
                sites = await SiteService.GetAllSitesAsync();
                errorMessage = null;
            }
        }
        catch (ApiException ex)
        {
            errorMessage = ex.Message;
        }
        catch (HttpRequestException)
        {
            errorMessage = "Erreur lors de la suppression du site.";
        }
    }
}
