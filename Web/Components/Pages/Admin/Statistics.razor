@page "/statistics"
@rendermode InteractiveServer
@inject ISiteService SiteService
@inject IStatisticsService StatisticsService

<PageTitle>Chiffre d'affaires</PageTitle>

<MudText Typo="Typo.h4" GutterBottom="true">Chiffre d'affaires</MudText>

@if (!string.IsNullOrEmpty(errorMessage))
{
    <MudAlert Severity="Severity.Error" Class="mb-4" OnClose="@(() => errorMessage = null)">@errorMessage</MudAlert>
}

<MudPaper Class="pa-6" Elevation="1">
    <MudGrid>
        <MudItem xs="12" md="3">
            <MudSelect T="int?" Label="Site" @bind-Value="selectedSiteId" Variant="Variant.Outlined" Margin="Margin.Dense">
                <MudSelectItem T="int?" Value="@((int?)null)">Tous mes sites</MudSelectItem>
                @foreach (var site in sites)
                {
                    <MudSelectItem T="int?" Value="@site.Id">@site.Name</MudSelectItem>
                }
            </MudSelect>
        </MudItem>
        <MudItem xs="12" md="3">
            <MudDatePicker Label="Du" @bind-Date="start" Variant="Variant.Outlined" Margin="Margin.Dense" />
        </MudItem>
        <MudItem xs="12" md="3">
            <MudDatePicker Label="Au" @bind-Date="end" Variant="Variant.Outlined" Margin="Margin.Dense" />
        </MudItem>
        <MudItem xs="12" md="3" Class="d-flex align-center">
            <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="@(loading || start is null || end is null)" OnClick="CalculateAsync">
                Calculer
            </MudButton>
        </MudItem>
    </MudGrid>

    @if (result != null)
    {
        <MudText Typo="Typo.h5" Class="mt-6" Color="Color.Success">@result.Amount.ToString("C")</MudText>
        <MudText Typo="Typo.caption">du @result.Start.ToString("d") au @result.End.ToString("d")</MudText>
    }
</MudPaper>

@code {
    private IEnumerable<SiteDto> sites = [];
    private int? selectedSiteId;
    private DateTime? start = DateTime.Today.AddMonths(-1);
    private DateTime? end = DateTime.Today;
    private RevenueDto? result;
    private bool loading;
    private string? errorMessage;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            sites = await SiteService.GetAllSitesAsync();
        }
        catch (ApiException ex)
        {
            errorMessage = ex.Message;
        }
        catch (HttpRequestException)
        {
            errorMessage = "Impossible de joindre le serveur.";
        }
    }

    private async Task CalculateAsync()
    {
        loading = true;
        try
        {
            result = await StatisticsService.CalculateRevenueAsync(
                selectedSiteId, DateOnly.FromDateTime(start!.Value), DateOnly.FromDateTime(end!.Value));
        }
        catch (ApiException ex)
        {
            errorMessage = ex.Message;
        }
        catch (HttpRequestException)
        {
            errorMessage = "Impossible de joindre le serveur.";
        }
        finally
        {
            loading = false;
        }
    }
}
