@page "/statistiques"
@rendermode InteractiveServer
@inject ISiteService SiteService
@inject IStatistiquesService StatistiquesService

<PageTitle>Revenue</PageTitle>

<MudText Typo="Typo.h4" GutterBottom="true">Revenue</MudText>

@if (!string.IsNullOrEmpty(errorMessage))
{
    <MudAlert Severity="Severity.Error" Class="mb-4" OnClose="@(() => errorMessage = null)">@errorMessage</MudAlert>
}

<MudPaper Class="pa-6" Elevation="1">
    <MudGrid>
        <MudItem xs="12" md="3">
            <MudSelect T="int?" Label="Site" @bind-Value="selectedSiteId" Variant="Variant.Outlined" Margin="Margin.Dense">
                <MudSelectItem T="int?" Value="@((int?)null)">All my sites</MudSelectItem>
                @foreach (var site in sites)
                {
                    <MudSelectItem T="int?" Value="@site.Id">@site.Name</MudSelectItem>
                }
            </MudSelect>
        </MudItem>
        <MudItem xs="12" md="3">
            <MudDatePicker Label="From" @bind-Date="debut" Variant="Variant.Outlined" Margin="Margin.Dense" />
        </MudItem>
        <MudItem xs="12" md="3">
            <MudDatePicker Label="To" @bind-Date="fin" Variant="Variant.Outlined" Margin="Margin.Dense" />
        </MudItem>
        <MudItem xs="12" md="3" Class="d-flex align-center">
            <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="@(loading || debut is null || fin is null)" OnClick="CalculerAsync">
                Calculate
            </MudButton>
        </MudItem>
    </MudGrid>

    @if (result != null)
    {
        <MudText Typo="Typo.h5" Class="mt-6" Color="Color.Success">@result.Montant.ToString("C")</MudText>
        <MudText Typo="Typo.caption">from @result.Debut.ToString("d") to @result.Fin.ToString("d")</MudText>
    }
</MudPaper>

@code {
    private IEnumerable<SiteDto> sites = [];
    private int? selectedSiteId;
    private DateTime? debut = DateTime.Today.AddMonths(-1);
    private DateTime? fin = DateTime.Today;
    private ChiffreAffairesDto? result;
    private bool loading;
    private string? errorMessage;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            sites = await SiteService.GetAllSitesAsync();
        }
        catch (ApiException ex)
        {
            errorMessage = ex.Message;
        }
        catch (HttpRequestException)
        {
            errorMessage = "Unable to reach the server.";
        }
    }

    private async Task CalculerAsync()
    {
        loading = true;
        try
        {
            result = await StatistiquesService.GetChiffreAffairesAsync(
                selectedSiteId, DateOnly.FromDateTime(debut!.Value), DateOnly.FromDateTime(fin!.Value));
        }
        catch (ApiException ex)
        {
            errorMessage = ex.Message;
        }
        catch (HttpRequestException)
        {
            errorMessage = "Unable to reach the server.";
        }
        finally
        {
            loading = false;
        }
    }
}
