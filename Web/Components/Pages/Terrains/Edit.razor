@page "/terrains/create"
@page "/terrains/edit/{Id:int}"
@rendermode InteractiveServer
@inject NavigationManager NavigationManager
@inject ITerrainService TerrainService
@inject ISiteService SiteService

@using System.ComponentModel.DataAnnotations

<PageTitle>@(Id == null ? "Créer un terrain" : "Modifier le terrain")</PageTitle>

<MudText Typo="Typo.h4" GutterBottom="true">@(Id == null ? "Créer un terrain" : "Modifier le terrain")</MudText>

@if (loading)
{
    <MudProgressCircular Color="Color.Primary" Indeterminate="true" />
}
else
{
    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <MudAlert Severity="Severity.Error" Class="mb-4" OnClose="@(() => errorMessage = null)">@errorMessage</MudAlert>
    }

    <MudPaper Class="pa-6" Elevation="1">
        <EditForm Model="model" OnValidSubmit="HandleValidSubmit">
            <DataAnnotationsValidator />

            <MudGrid>
                <MudItem xs="12" md="6">
                    <MudTextField Label="Nom" @bind-Value="model.Name" For="@(() => model.Name)" Required="true" Variant="Variant.Outlined" Margin="Margin.Dense" />
                </MudItem>
                <MudItem xs="12" md="6">
                    @if (Id == null)
                    {
                        <MudSelect T="int" Label="Site" @bind-Value="model.SiteId" Required="true" Variant="Variant.Outlined" Margin="Margin.Dense">
                            @foreach (var site in sites)
                            {
                                <MudSelectItem T="int" Value="@site.Id">@site.Name</MudSelectItem>
                            }
                        </MudSelect>
                    }
                    else
                    {
                        <MudTextField Label="Site" Value="@SiteName(model.SiteId)" ReadOnly="true" Variant="Variant.Outlined" Margin="Margin.Dense" />
                    }
                </MudItem>
                <MudItem xs="12" md="4">
                    <MudTextField Label="Numéro" @bind-Value="model.Numero" For="@(() => model.Numero)" Variant="Variant.Outlined" Margin="Margin.Dense" />
                </MudItem>
                <MudItem xs="12" md="4">
                    <MudTextField Label="Type de surface" @bind-Value="model.TypeSurface" For="@(() => model.TypeSurface)" Variant="Variant.Outlined" Margin="Margin.Dense" />
                </MudItem>
                <MudItem xs="12" md="4" Class="d-flex align-center">
                    <MudSwitch T="bool" @bind-Value="model.Couvert" Color="Color.Primary" Label="Terrain couvert" />
                </MudItem>
                @if (Id != null)
                {
                    <MudItem xs="12" md="4" Class="d-flex align-center">
                        <MudSwitch T="bool" @bind-Value="model.Actif" Color="Color.Primary" Label="Actif" />
                    </MudItem>
                }
                <MudItem xs="12" Class="d-flex align-center justify-end">
                    <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary" Class="ml-auto">Enregistrer</MudButton>
                    <MudButton Variant="Variant.Outlined" Color="Color.Secondary" Class="ml-2" Href="/terrains">Annuler</MudButton>
                </MudItem>
            </MudGrid>
        </EditForm>
    </MudPaper>
}

@code {
    [Parameter]
    public int? Id { get; set; }

    private TerrainModel model = new();
    private IEnumerable<SiteDto> sites = [];
    private bool loading = false;
    private string? errorMessage;

    protected override async Task OnInitializedAsync()
    {
        loading = true;
        try
        {
            sites = await SiteService.GetAllSitesAsync();

            if (Id != null)
            {
                var terrain = await TerrainService.GetTerrainByIdAsync(Id.Value);
                model = new TerrainModel
                {
                    Name = terrain.Name,
                    SiteId = terrain.SiteId,
                    Numero = terrain.Numero,
                    TypeSurface = terrain.TypeSurface,
                    Couvert = terrain.Couvert,
                    Actif = terrain.Actif
                };
            }
            else if (sites.Any())
            {
                model.SiteId = sites.First().Id;
            }
        }
        catch (ApiException ex)
        {
            errorMessage = ex.Message;
        }
        catch (HttpRequestException)
        {
            errorMessage = "Impossible de joindre le serveur.";
        }
        finally
        {
            loading = false;
        }
    }

    private async Task HandleValidSubmit()
    {
        try
        {
            if (Id == null)
                await TerrainService.CreateTerrainAsync(new CreateTerrainDto(model.Name, model.SiteId, model.Numero, model.TypeSurface, model.Couvert));
            else
                await TerrainService.UpdateTerrainAsync(Id.Value, new UpdateTerrainDto(model.Name, model.Numero, model.TypeSurface, model.Couvert, model.Actif));

            NavigationManager.NavigateTo("/terrains");
        }
        catch (ApiException ex)
        {
            errorMessage = ex.Message;
        }
        catch (HttpRequestException)
        {
            errorMessage = "Impossible de joindre le serveur.";
        }
    }

    private string SiteName(int siteId) => sites.FirstOrDefault(s => s.Id == siteId)?.Name ?? $"#{siteId}";

    public class TerrainModel
    {
        [Required]
        [StringLength(100)]
        public string Name { get; set; } = string.Empty;

        [Required]
        public int SiteId { get; set; }

        [StringLength(20)]
        public string? Numero { get; set; }

        [StringLength(50)]
        public string? TypeSurface { get; set; }

        public bool Couvert { get; set; }

        public bool Actif { get; set; } = true;
    }
}
