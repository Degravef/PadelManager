@page "/terrains"
@rendermode InteractiveServer
@inject ITerrainService TerrainService
@inject ISiteService SiteService
@inject NavigationManager NavigationManager
@inject IJSRuntime JS

<PageTitle>Terrains</PageTitle>

<MudText Typo="Typo.h4" GutterBottom="true">Terrains</MudText>

<MudToolBar DisableGutters="true" Class="mb-4">
    <MudSelect T="int?" Label="Filter by site" Value="selectedSiteId" ValueChanged="OnSiteFilterChanged" Clearable="true" Class="mr-4" Style="max-width:300px">
        @foreach (var site in sites)
        {
            <MudSelectItem T="int?" Value="@site.Id">@site.Name</MudSelectItem>
        }
    </MudSelect>
    <MudSpacer />
    <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" Href="/terrains/create">Add Terrain</MudButton>
</MudToolBar>

@if (!string.IsNullOrEmpty(errorMessage))
{
    <MudAlert Severity="Severity.Error" Class="mb-4" OnClose="@(() => errorMessage = null)">@errorMessage</MudAlert>
}

<MudTable Items="@terrains" Loading="@(terrains == null)" Dense="true" Hover="true" Bordered="false" Striped="true" Elevation="1">
    <HeaderContent>
        <MudTh>Name</MudTh>
        <MudTh>Site</MudTh>
        <MudTh>Number</MudTh>
        <MudTh>Surface</MudTh>
        <MudTh>Covered</MudTh>
        <MudTh>Status</MudTh>
        <MudTh Style="text-align:right">Actions</MudTh>
    </HeaderContent>
    <RowTemplate>
        <MudTd DataLabel="Name">@context.Name</MudTd>
        <MudTd DataLabel="Site">@SiteName(context.SiteId)</MudTd>
        <MudTd DataLabel="Number">@(context.Numero ?? "-")</MudTd>
        <MudTd DataLabel="Surface">@(context.TypeSurface ?? "-")</MudTd>
        <MudTd DataLabel="Covered">@(context.Couvert ? "Yes" : "No")</MudTd>
        <MudTd DataLabel="Status">
            <MudChip T="string" Size="Size.Small" Color="@(context.Actif ? Color.Success : Color.Default)">@(context.Actif ? "Active" : "Inactive")</MudChip>
        </MudTd>
        <MudTd DataLabel="Actions" Style="text-align:right">
            <MudIconButton Icon="@Icons.Material.Filled.Edit" Color="Color.Warning" Size="Size.Small" Href="@($"/terrains/edit/{context.Id}")" Title="Edit" />
            <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" Size="Size.Small" OnClick="@(() => DeleteTerrain(context.Id))" Title="Delete" />
        </MudTd>
    </RowTemplate>
    <NoRecordsContent>
        <MudText>No terrains found.</MudText>
    </NoRecordsContent>
    <LoadingContent>
        <MudText>Loading terrains...</MudText>
    </LoadingContent>
</MudTable>

@code {
    private IEnumerable<TerrainDto>? terrains;
    private IEnumerable<SiteDto> sites = [];
    private int? selectedSiteId;
    private string? errorMessage;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            sites = await SiteService.GetAllSitesAsync();
            terrains = await TerrainService.GetAllTerrainsAsync();
        }
        catch (Exception ex)
        {
            errorMessage = $"error loading terrains: {ex}";
        }
    }

    private async Task OnSiteFilterChanged(int? siteId)
    {
        selectedSiteId = siteId;
        try
        {
            terrains = await TerrainService.GetAllTerrainsAsync(selectedSiteId);
        }
        catch (Exception ex)
        {
            errorMessage = $"error loading terrains: {ex}";
        }
    }

    private async Task DeleteTerrain(int id)
    {
        try
        {
            if (await JS.InvokeAsync<bool>("confirm", "Are you sure you want to delete this terrain?"))
            {
                await TerrainService.DeleteTerrainAsync(id);
                terrains = await TerrainService.GetAllTerrainsAsync(selectedSiteId);
                errorMessage = null;
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Error deleting terrain: {ex.Message}";
        }
    }

    private string SiteName(int siteId) => sites.FirstOrDefault(s => s.Id == siteId)?.Name ?? $"#{siteId}";
}
