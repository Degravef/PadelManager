@using Web.Core.Interfaces
@using Web.Services.Context
@inject UserContext UserContext
@inject NavigationManager NavigationManager
@inject IIdentityService IdentityService

<div class="d-flex align-center px-4 py-2" style="height: 64px;">
    <MudToggleGroup T="Role" Value="UserContext.Role" ValueChanged="OnRoleChanged"
                    Dense="true" Class="mr-4" Outline="false"
                    Style="background-color: rgba(255,255,255,0.1);">
        <MudToggleItem Value="@(Role.Member)" Text="Membre"/>
        <MudToggleItem Value="@(Role.Admin)"  Text="Administrateur"/>
    </MudToggleGroup>

    <MudSelect T="string" Value="_pendingId" ValueChanged="OnIdSelected"
               Label="@(UserContext.Role == Role.Member ? "Matricule" : "Admin ID")"
               Variant="Variant.Filled"
               Margin="Margin.Dense"
               Class="flex-grow-0"
               Style="width: 200px; background-color: rgba(255,255,255,0.1);">
        @foreach (var id in _idOptions)
        {
            <MudSelectItem Value="@id">@id</MudSelectItem>
        }
    </MudSelect>
</div>

@code {
    private string[] _idOptions = [];
    private string _pendingId = "";

    protected override async Task OnInitializedAsync()
    {
        _pendingId = UserContext.Id;
        await LoadOptionsAsync(UserContext.Role);
    }

    // Admin ids come from Sites.AdminId (an admin only exists insofar as they own a
    // site) and member ids from Membres.Matricule — both via the anonymous
    // api/identity endpoints, since the switcher itself runs before any identity is set.
    private async Task LoadOptionsAsync(Role role)
    {
        _idOptions = role == Role.Admin
            ? (await IdentityService.GetAdminIdsAsync()).Select(id => id.ToString()).ToArray()
            : (await IdentityService.GetMatriculesAsync()).ToArray();
    }

    private async Task OnRoleChanged(Role newRole)
    {
        await LoadOptionsAsync(newRole);
        Navigate(newRole, UserContext.Id);
    }

    private void OnIdSelected(string id) => Navigate(UserContext.Role, id);

    private void Navigate(Role role, string id)
    {
        var uri = NavigationManager.GetUriWithQueryParameters(new Dictionary<string, object?>
        {
            ["role"] = role.ToString(),
            ["id"] = id
        });
        NavigationManager.NavigateTo(uri, forceLoad: true);
    }
}